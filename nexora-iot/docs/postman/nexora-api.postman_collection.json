{
  "info": {
    "name": "NEXORA IoT API",
    "description": "All NEXORA backend endpoints. Run 'Auth / Login' first: its test script stores {{token}} for every other request. Set {{baseUrl}} (default http://localhost:8080/api/v1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "admin123" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (API-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        { "name": "Me (API-02)", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
        {
          "name": "Update profile (E-4)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bio\": \"Sinh viên Học viện Công nghệ Bưu chính Viễn thông.\",\n  \"figma_url\": \"\"\n}" },
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Change password (E-5)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"old_password\": \"{{password}}\",\n  \"new_password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/password"
          }
        },
        { "name": "Logout (API-03)", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Sensors",
      "item": [
        { "name": "Sensor catalog (API-06)", "request": { "method": "GET", "url": "{{baseUrl}}/sensors" } },
        {
          "name": "Latest data per sensor (API-04)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sensors/data?limit=1", "host": ["{{baseUrl}}"], "path": ["sensors", "data"], "query": [{ "key": "limit", "value": "1" }] }
          }
        },
        {
          "name": "Dashboard chart (API-05)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/dashboard/sensors/chart?sensorId=1&from=2026-01-01 00:00:00&limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "sensors", "chart"],
              "query": [
                { "key": "sensorId", "value": "1" },
                { "key": "from", "value": "2026-01-01 00:00:00" },
                { "key": "limit", "value": "200" }
              ]
            }
          }
        },
        {
          "name": "Sensor history search (API-07)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/history?search=25&search_kind=temp&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "history"],
              "query": [
                { "key": "sensors_id", "value": "1", "disabled": true },
                { "key": "from", "value": "2026-10-01 00:00:00", "disabled": true },
                { "key": "to", "value": "2026-10-31 23:59:59", "disabled": true },
                { "key": "search", "value": "25" },
                { "key": "search_kind", "value": "temp", "description": "all | temp | humid | light | time" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        { "name": "Device list (API-08)", "request": { "method": "GET", "url": "{{baseUrl}}/devices" } },
        {
          "name": "Control one device (API-09)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"devices_id\": 2,\n  \"action\": \"on\"\n}" },
            "url": "{{baseUrl}}/devices/control"
          }
        },
        {
          "name": "Control all devices (E-1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"all\": \"off\",\n  \"action\": \"off\"\n}" },
            "url": "{{baseUrl}}/devices/control"
          }
        },
        {
          "name": "Device history (API-10)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/devices/history?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "history"],
              "query": [
                { "key": "device_id", "value": "1", "disabled": true },
                { "key": "action", "value": "on", "disabled": true },
                { "key": "status", "value": "failed", "disabled": true, "description": "success | failed | loading" },
                { "key": "search", "value": "2026/10", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    }
  ]
}
