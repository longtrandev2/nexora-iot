# Copy to .env (gitignored). All optional.
# mock (default): in-browser simulator, no backend needed.
# http: real Spring Boot backend (REST /api/v1 + STOMP /ws, proxied by `npm run dev`).
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# Leave empty to use same-origin /ws through the Vite proxy; set e.g. ws://localhost:8080/ws to bypass it.
VITE_WS_URL=
