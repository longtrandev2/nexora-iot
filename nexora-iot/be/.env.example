# Copy file này thành be/.env rồi điền giá trị (be/.env không bị commit).
# Backend tự đọc be/.env khi chạy trong thư mục be/ (java -jar target/nexora-be-1.0.0.jar).
# Viết KEY=VALUE, không dùng dấu nháy, không để khoảng trắng quanh dấu =.

# ---------- MySQL (local) ----------
# Database `nexora` và các bảng được Hibernate tự tạo -> user cần quyền tạo database (vd root).
DB_URL=jdbc:mysql://localhost:3306/nexora?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=

# ---------- MQTT broker (Mosquitto) ----------
# Broker chạy trên chính laptop -> localhost (không phụ thuộc IP Wi-Fi).
# Chỉ code ESP32 mới cần IP Wi-Fi của laptop (ipconfig -> IPv4).
MQTT_HOST=localhost
MQTT_PORT=2005
MQTT_USERNAME=TranKhacLong
MQTT_PASSWORD=

# ---------- JWT ----------
# Chuỗi bất kỳ, tối thiểu 32 ký tự.
JWT_SECRET=

# ---------- Tùy chọn ----------
# SERVER_PORT=8080
# CORS_ORIGIN=http://localhost:5173
